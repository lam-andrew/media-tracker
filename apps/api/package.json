{
  "name": "@marqd/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/index.js",
    "typecheck": "tsc --noEmit",
    "test": "cd ../.. && apps/api/node_modules/.bin/tsx --test apps/api/src/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.6.0",
    "google-auth-library": "^11.1.0",
    "nodemailer": "^10.0.11",
    "pg": "^8.16.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "eslint": "^10.11.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.70.1"
  },
  "engines": {
    "node": ">=22"
  }
}
