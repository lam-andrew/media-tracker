{
  "name": "media-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "docker compose -f infra/compose.yaml up --build",
    "install:apps": "npm ci --prefix packages/contracts && npm ci --prefix apps/api && npm ci --prefix apps/web",
    "lint": "apps/api/node_modules/.bin/eslint -c eslint.config.mjs apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --prefix apps/api && npm run typecheck --prefix apps/web",
    "test": "npm run test:api && npm run test:ui",
    "test:api": "npm run test --prefix apps/api",
    "test:ui": "vitest run",
    "test:watch": "vitest",
    "build": "npm run build --prefix apps/api && npm run build --prefix apps/web",
    "start": "docker compose -f infra/compose.yaml up -d --wait",
    "up": "docker compose -f infra/compose.yaml up --build -d",
    "stop": "docker compose -f infra/compose.yaml stop",
    "v2:install": "npm run install:apps",
    "v2:lint": "npm run lint",
    "v2:typecheck": "npm run typecheck",
    "v2:test": "npm run test:api",
    "v2:test:ui": "npm run test:ui",
    "v2:build": "npm run build",
    "v2:up": "npm run up",
    "v2:stop": "npm run stop"
  },
  "dependencies": {
    "lucide-react": "^1.35.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.6",
    "typescript": "^5",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
