# Copy to .env.local and fill in as features need them. Never commit real secrets.
# See docs/BUILD.md §3 for where to get each value.

# --- Supabase (managed PostgreSQL) ---
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser). Used by server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (movies + TV) ---
# API Read Access Token (v4) from themoviedb.org → Settings → API.
TMDB_ACCESS_TOKEN=

# --- RAWG (games) ---
# API key from rawg.io/apidocs.
RAWG_API_KEY=

# --- Books (Google Books, primary; Open Library, fallback) ---
# Neither key is required — book search works without them. But unauthenticated
# Google Books shares a tight per-IP quota and 429s under load, forcing the
# slower Open Library fallback. Set an optional Google Books API key (Google
# Cloud console → enable "Books API" → create an API key) to raise the quota and
# stay on the fast path.
GOOGLE_BOOKS_API_KEY=
