# Copy to .env.local and fill in as features need them. Never commit real secrets.
# See docs/BUILD.md §3 for where to get each value.

# --- Supabase (managed PostgreSQL) ---
# From your Supabase project: Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only (never exposed to the browser). Used by server actions / route handlers.
SUPABASE_SERVICE_ROLE_KEY=

# --- TMDB (movies + TV) ---
# API Read Access Token (v4) from themoviedb.org → Settings → API.
TMDB_ACCESS_TOKEN=

# --- RAWG (games) ---
# API key from rawg.io/apidocs.
RAWG_API_KEY=

# --- Books (Open Library, primary; Google Books, backup) ---
# No key required — book search works out of the box via Open Library.
# Google Books is the faster, slightly richer source but 429s without a key on
# shared IPs, so it's the backup. Setting an optional Google Books API key
# (Google Cloud console → enable "Books API" → create an API key) makes its fast
# path reliable; then flip the order in lib/providers/book.ts to make it primary.
GOOGLE_BOOKS_API_KEY=
