# Generate a URL-safe random password locally. Never reuse production credentials.
POSTGRES_PASSWORD=replace-with-random-hex
APP_ORIGIN=http://localhost:3200
COOKIE_SECURE=false
# Local development only; disable registration before exposing a public deployment.
ALLOW_REGISTRATION=true

# Metadata (server only)
TMDB_ACCESS_TOKEN=
RAWG_API_KEY=
# Optional Google sign-in; register APP_ORIGIN/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Enable email confirmation only with working SMTP
REQUIRE_EMAIL_CONFIRMATION=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Host binding; homelab owner chooses network/proxy exposure
BIND_ADDRESS=127.0.0.1
WEB_PORT=3200

# Optional backup book catalog quota
GOOGLE_BOOKS_API_KEY=

# BoardGameGeek application bearer token (optional board-game catalog)
BGG_API_TOKEN=
